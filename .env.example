# Plantilla de configuración. Copiar a `.env` y rellenar.
#
# El `.env` real está en `.gitignore` y no debe subirse nunca. Este fichero sí se
# versiona, y por eso aquí no va ningún valor real: solo el nombre de cada
# variable y qué pasa si falta.

# --- Servidor -------------------------------------------------------------

# Puerto de escucha. En App Runner y ECS lo inyecta la plataforma.
PORT=3001

# `0.0.0.0` es obligatorio dentro de un contenedor: con `127.0.0.1` el servicio
# arranca pero nadie de fuera puede alcanzarlo, y el balanceador lo declara
# muerto sin explicar por qué.
HOST=0.0.0.0

# Orígenes admitidos por CORS, separados por comas. Si el frontend lo sirve este
# mismo servicio (FRONTEND_DIR), no hace falta tocarlo: todo va al mismo origen.
CORS_ORIGINS=http://localhost:5173

# Firma de los tokens de sesión.
#
# En producción es OBLIGATORIA. Sin ella el servicio genera una y la guarda en
# DATA_DIR, lo que con varias instancias significa que cada una firma con un
# secreto distinto y rechaza los tokens de las demás: la sesión se cae de forma
# intermitente según a qué instancia caiga cada petición.
#
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Duración de la sesión en segundos.
SESSION_TTL=43200

# --- Almacenamiento -------------------------------------------------------

# Cadena de conexión a PostgreSQL. Su presencia decide el almacén: con ella los
# usuarios, los proyectos y los documentos van a la base de datos; sin ella, a
# ficheros bajo DATA_DIR. Los tres a la vez, nunca por separado.
#
# En cualquier despliegue con sistema de ficheros efímero —App Runner, ECS,
# Render— NO es opcional: sin ella los usuarios, los proyectos y los diagramas
# se guardan en disco y desaparecen en cada despliegue.
#
# Requiere el driver, que no viene instalado:
#   npm install --workspace @app/backend-tool pg
#
# El esquema (backend-tool/sql/esquema.sql) se aplica solo en cada arranque.
#
# `sslmode` se respeta como en psql. Contra RDS lo correcto es `verify-full` con
# el bundle de autoridades de Amazon en NODE_EXTRA_CA_CERTS; `require` cifra pero
# no comprueba de quién es el certificado. Sin sslmode y contra un host remoto se
# cifra sin verificar, que es lo mínimo para que RDS conteste.
#
# Formato: postgresql://usuario:contraseña@host:5432/basededatos?sslmode=verify-full
DATABASE_URL=

# Solo se usa cuando no hay DATABASE_URL: directorio de los ficheros JSON y de
# los documentos colaborativos.
DATA_DIR=./datos

# Directorio del frontend construido, si este servicio también lo sirve.
# Vacío en desarrollo, donde el frontend lo sirve Vite con su proxy.
# En la imagen Docker vale /app/frontend/dist.
FRONTEND_DIR=

# --- Modelos de lenguaje --------------------------------------------------

# Clave del proveedor de texto (asistente por voz y por escrito).
# NUNCA como variable VITE_*: Vite las incrusta en el paquete del navegador y la
# clave quedaría publicada.
#
# LLM_PROVIDER es el *protocolo*, no la marca: cualquier nombre que no sea
# «anthropic» se trata como compatible con OpenAI (`/chat/completions` con
# `Authorization: Bearer`), que es lo que sirven Gemini, DeepSeek, OpenAI, Groq
# y casi todo lo demás. Por eso poner «gemini» aquí funciona sin tocar código.
#
# Un solo proveedor para texto y visión es lo recomendado: una clave que rotar,
# una cuenta que vigilar y una factura. Además, cuando LLM_VISION_BASE_URL
# coincide con LLM_BASE_URL, la clave de visión se hereda y no hay que repetirla.
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Modelo con visión, para leer diagramas fotografiados.
#
# Hace falta declararlo aunque sea el mismo que el de texto: sin él la lectura
# por foto se desactiva con un mensaje claro en lugar de fallar a mitad.
#
# Gemini es el único que tenemos comprobado leyendo fotos de pizarra. DeepSeek
# también anuncia visión —`deepseek-v4-flash-vision-exp`—, pero sin probar.
LLM_VISION_MODEL=gemini-3.6-flash

# Solo si la visión va a otro proveedor distinto del de texto. Vacías, se
# heredan LLM_BASE_URL y LLM_API_KEY.
#
# LLM_VISION_BASE_URL tiene que ser la raíz de la API, no el dominio del
# fabricante: el código le añade `/chat/completions`. Apuntarla a
# `https://googleapis.com` da un 404 en HTML que parece un modelo retirado y no
# lo es (ver docs/05, tabla de diagnóstico).
#
# La clave del texto NO se presta a un proveedor distinto, a propósito:
# heredarla siempre significaría entregarle a Google la clave de DeepSeek en
# cuanto alguien apunta la visión a otro sitio y se deja la suya sin poner.
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# Tamaño máximo de una foto para OCR, en bytes. Por defecto 4 MiB.
MAX_IMAGE_BYTES=4194304
